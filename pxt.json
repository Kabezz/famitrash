{
    "name": "Famitrash",
    "description": "Introducing MakeCode Dash! A new demake of Geometry Dash for the Microsoft MakeCode Arcade!",
    "dependencies": {
        "device": "*",
        "arcade-piano-roll": "github:microsoft/arcade-piano-roll#v0.0.1",
        "Color Fading": "github:jwunderl/pxt-color#v0.2.3",
        "arcade-background-scroll": "github:microsoft/arcade-background-scroll#v0.1.4",
        "arcade-fancy-text": "github:riknoll/arcade-fancy-text#v0.2.2"
    },
    "files": [
        "main.blocks",
        "main.ts",
        "README.md",
        "assets.json",
        "tilemap.g.jres",
        "tilemap.g.ts",
        "images.g.jres",
        "images.g.ts"
    ],
    "testFiles": [
        "test.ts"
    ],
    "targetVersions": {
        "target": "4.1.27",
        "targetId": "arcade"
    },
    "supportedTargets": [
        "arcade"
    ],
    "preferredEditor": "blocksprj",
    "theme": {
        "layout": "junior",
        "background-color": "#3F3F3F",
        "button-stroke": "#212121",
        "text-color": "#D9D9D9",
        "button-fill": "#2D2D2D",
        "dpad-fill": "#212121",
        "joystick-handle-stroke": "#212121"
    }
}
